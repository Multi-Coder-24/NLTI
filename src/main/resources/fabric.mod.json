{
  "schemaVersion": 1,
  "id": "nlti",
  "version": "${version}",
  "name": "Next Level Twitch Integration",
  "description": "A mod for streamers to use, Allows chat to cause chaos",
  "authors": ["Multicoder"],
  "contact": {},
  "license": "LGPLv3",
  "icon": "assets/nlti/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "org.multicoder.nlti.client.NLTIClient"
    ],
    "main": [
      "org.multicoder.nlti.NLTI"
    ]
  },
  "mixins": [
    "nlti.mixins.json"
